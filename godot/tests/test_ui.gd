extends TestBase
## The HTML renderer (cards are written as HTML, as in the web version) and the sound module.


func run() -> void:
	var tree := Engine.get_main_loop() as SceneTree
	# parsing
	var nodes := Html.parse("<div class=\"info-row good\"><span class=\"ic\">😎</span><div><b>No storm</b><p>Calm &amp; quiet.</p></div></div><br>tail")
	ok("parse: a block, a line break and text", nodes.size() == 3, str(nodes.size()))
	ok("parse: classes", Html.has_class(nodes[0], "good"))
	ok("parse: entities decoded", Html.plain("<p>Calm &amp; quiet &rarr; on</p>") == "Calm & quiet → on")
	ok("parse: unclosed p closes on the next p", Html.parse("<p>a<p>b").size() == 2)
	ok("parse: attributes with > inside quotes", Html.parse("<button data-act=\"go\" title=\"a > b\">Go</button>")[0].attrs.title == "a > b")
	ok("esc", Html.esc("<b>\"x\" & y</b>") == "&lt;b&gt;&quot;x&quot; &amp; y&lt;/b&gt;")
	# rendering and actions
	var hit := []
	var doc := Html.render("<h2>Hi</h2><p id=\"msg\">Hello <b>there</b> 🔋</p><input id=\"code\" value=\"AB12\"><div class=\"modal-actions\"><button class=\"btn ghost\" data-act=\"no\">No</button><button class=\"btn primary\" data-act=\"yes\">Yes</button></div>",
		{ "yes": func(): hit.append("yes"), "no": func(b): hit.append("no:" + b.text) })
	tree.root.add_child(doc.root)
	ok("render: two buttons", doc.buttons.size() == 2)
	ok("render: the primary button is focused first", doc.first_button() != null and doc.first_button().text == "Yes")
	doc.buttons[0].pressed.emit()
	doc.buttons[1].pressed.emit()
	ok("render: actions run with and without the button", hit == ["no:No", "yes"], str(hit))
	ok("render: ids", doc.el("msg") is RichTextLabel)
	ok("render: icons become images", (doc.el("msg") as RichTextLabel).text.find("cell.svg") >= 0)
	ok("render: input value", doc.value("code") == "AB12")
	doc.set_html("msg", "<b>Changed</b>")
	ok("render: set_html", (doc.el("msg") as RichTextLabel).text.find("Changed") >= 0)
	doc.root.queue_free()
	# the interface
	var ui = tree.root.get_node("Ui")
	var d2: Html.Doc = ui.modal("<h2>Card</h2><div class=\"cards\"><button class=\"pick\" data-act=\"a\"><b>A</b><span>first</span></button><button class=\"pick\" data-act=\"b\"><b>B</b><span>second</span></button></div>", { "actions": { "a": func(): hit.append("a") } })
	ok("ui: modal opens", ui.modal_open())
	d2.buttons[0].pressed.emit()
	ok("ui: pick card action", hit.back() == "a")
	ui.close_modal()
	ok("ui: modal closes", not ui.modal_open())
	ui.card({ "kind": "why", "icon": "💨", "title": "T", "text": "x" })
	ui.card({ "kind": "core", "icon": "🧪", "title": "U", "text": "y" })
	ok("ui: first card shows", ui.card_now() != null and ui.card_now().title == "T")
	ui.tick_cards(14)
	ok("ui: cards follow each other in game time", ui.card_now() != null and ui.card_now().title == "U")
	ui.clear_cards()
	ok("ui: clear cards", ui.card_now() == null)
	# sound
	var au = tree.root.get_node("Au")
	ok("audio: sfx settings loaded", au.META.has("tap") and au.META.has("rover"))
	ok("audio: voice lines loaded", au.VOICE.size() > 50)
	au.play("tap")
	ok("audio: a recording plays", au.log_list.back() == "tap", str(au.log_list.back()))
	au.play("click")
	ok("audio: a missing recording falls back to synth", au.log_list.back() == "synth:click", str(au.log_list.back()))
	var w := Synth.render("alarm")
	ok("audio: synth renders", w.data.size() > Synth.RATE)
	au.loop("rover", { "vol": 0.5, "at": Vector3(3, 0, 4) })
	ok("audio: loop starts", "rover" in au.loops_playing())
	au.stop_loop("rover")
	ok("audio: loop stops", not ("rover" in au.loops_playing()))
	au.loop("aim", { "f": 300, "v": 0.03, "type": "sine" })
	ok("audio: a loop with no recording plays a tone", "aim" in au.loops_playing() and au.log_list.back() == "synth-loop:aim", str(au.log_list.back()))
	au.stop_loop("aim")
	ok("audio: the tone stops", not ("aim" in au.loops_playing()))
	au.scene({ "place": "out", "site": "mars", "dust": 0.8, "storm": 2 })
	ok("audio: scene key", au.scene_key() == "out,mars,2,2")
	ok("audio: voice for text", au.voice_for(au.VOICE["hud-air-low"].t) == "hud-air-low")
	ok("audio: line by id", au.line("hud-air-low"))
	au.stop_voice()
	ok("audio: music exists", au.music("title"))
	au.music(null)
	au.gen.unlock()
	au.gen.set_mood("work")
	au.gen.set_site("mars")
	au.gen._process(0.1)
	ok("music: a mood starts notes", au.gen.voices_alive() >= 5, str(au.gen.voices_alive()))
	au.gen.set_mood("off")
